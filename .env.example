# Szablon zmiennych dla Alcohol Factory API (backend).
# Skopiuj do .env.local i uzupełnij wartości — plik .env.local jest w .gitignore.
#
# UWAGA: Spring Boot NIE wczytuje .env.local automatycznie (w przeciwieństwie do Next.js).
# Użyj jednej z metod z sekcji „Zmienne środowiskowe (lokalnie)” w RUN.md.

# Baza (domyślnie z compose.yaml — zmień tylko jeśli masz inną instancję)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/alcohol_db
SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=secret

# Produkcja: obowiązkowo silny losowy sekret (min. 32 znaki)
JWT_SECRET=dev-secret-key-min-256-bits-for-hs256-please-change-in-production

# Opcjonalnie — dodatkowe originy CORS (CSV, bez spacji po przecinku)
# APP_CORS_ALLOWED_ORIGINS=https://twoj-front.vercel.app,http://localhost:3000

# Opcjonalnie — Swagger: URL publicznego API
# APP_OPENAPI_SERVER_URL=https://api-alcozon.onrender.com

# Opcjonalnie — Firebase Admin (cały JSON service account w jednej linii lub w Render Secret)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# 2FA staff — Mailpit lokalnie (docker compose): SMTP localhost:1025, UI http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_FROM=noreply@alkozon.local
# APP_TWO_FACTOR_ENABLED=true

# Produkcja Render (demo 2FA bez SMTP): kody w logach, health bez Mailpit
# MAIL_LOG_ONLY=true

# Produkcja: prawdziwy SMTP (SendGrid itd.) — MAIL_LOG_ONLY=false, ustaw SMTP_*
# MANAGEMENT_HEALTH_MAIL_ENABLED=true
